# ============================================================
#  Bastion – Konfiguration
#  Kopieren nach .env und Werte anpassen:  cp .env.example .env
# ============================================================

# Öffentliche Adresse (muss exakt der Browser-URL entsprechen, wird für CSRF-Prüfung und Einladungslinks verwendet)
PUBLIC_URL=https://localhost
# Domain für Caddy/TLS (bei echter Domain: automatisches Let's-Encrypt-Zertifikat)
BASTION_DOMAIN=localhost
# Optional: Kontaktadresse für Let's Encrypt (Hinweise, falls ein Zertifikat nicht erneuert werden kann). Leer = ohne.
ACME_EMAIL=

# Geheimnisse – UNBEDINGT neu erzeugen (Platzhalter mit CHANGE_ME werden abgelehnt):
#   openssl rand -base64 48   (APP_SECRET)
#   openssl rand -hex 32      (Datenbank-Passwörter: nur Hex, da sie Teil der Verbindungs-URL sind)
APP_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
# Eigentümer der Datenbank (nur für Migrationen)
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32
# Eingeschränktes Konto der laufenden Anwendung
APP_DB_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32

# Optional: festes Initialpasswort für den ersten Admin (min. 16 Zeichen).
# Leer lassen → zufälliges Passwort wird im Log ausgegeben (docker compose logs bastion)
INITIAL_ADMIN_PASSWORD=

# Sitzungen
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
INVITE_VALIDITY_HOURS=72

# Papierkorb: Tage, bis gelöschte Einträge endgültig entfernt werden (1–365)
TRASH_RETENTION_DAYS=30

# HaveIBeenPwned-Prüfung (k-Anonymity) für Masterpasswörter und Sicherheitsbericht
HIBP_ENABLED=true

# Notfall-Backup: Verzeichnis auf dem Host für das Exportziel "Ordner / Netzlaufwerk" (im Container /backup).
# Leer = Docker-Volume "emergency-backup". Eigener Pfad (z. B. eingehängte NAS-Freigabe) muss für UID 1000 beschreibbar sein.
EMERGENCY_BACKUP_PATH=

# Automatisches Datenbank-Backup (Dienst "backup"): täglich verschlüsselt, siehe README Abschnitt "Datenbank-Backup".
# Öffentliche age-Schlüssel (age1…), mehrere durch Leerzeichen getrennt. Erzeugen:
#   docker compose run --rm -T backup keygen > bastion-backup-key.txt
# Die Datei enthält den PRIVATEN Schlüssel: offline aufbewahren, nicht auf dem Server lassen. Leer = es wird nicht gesichert.
BACKUP_AGE_RECIPIENTS=
# Uhrzeit (Zeitzone TZ) und Anzahl aufbewahrter Backups
BACKUP_TIME=02:30
BACKUP_KEEP=14
TZ=Europe/Berlin
# Zielverzeichnis auf dem Host (im Container /backups). Leer = Docker-Volume "db-backup" auf demselben Host.
# Empfohlen: anderer Datenträger oder eingehängte NAS-Freigabe, beschreibbar für UID 1000.
BACKUP_PATH=

# Obergrenzen für den Arbeitsspeicher (Schutz des Hosts bei Überlastung). Bei sehr großen Tresoren ggf. erhöhen.
BASTION_MEMORY_LIMIT=1g
DB_MEMORY_LIMIT=1g

# Ports des Reverse-Proxys
HTTP_PORT=80
HTTPS_PORT=443
