<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Zielplattform des Container-Images; im Lockfile mit festgehalten -->
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <RootNamespace>Bastion.Server</RootNamespace>
    <AssemblyName>Bastion.Server</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="MailKit" Version="5.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="Sodium.Core" Version="1.4.1" />
    <PackageReference Include="SSH.NET" Version="2026.0.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data/Migrations/*.sql" LogicalName="Bastion.Server.Data.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bastion.Server.Tests" />
  </ItemGroup>

</Project>
